{
  "name": "Inkasso RL Lab",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements-train.txt",
  "postStartCommand": "bash scripts/start_dashboard.sh",
  "forwardPorts": [
    8501
  ],
  "portsAttributes": {
    "8501": {
      "label": "Inkasso Streamlit dashboard",
      "onAutoForward": "openPreview"
    }
  }
}
